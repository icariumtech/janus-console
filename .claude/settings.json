{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-npm.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(grep:*)",
      "Bash(tr:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git tag:*)",
      "Bash(pnpm *)",
      "Bash(.venv/bin/python manage.py test:*)",
      "Bash(gsd_run:*)",
      "Bash(GSD_TOOLS=\"/home/gjohnson/.claude/gsd-core/bin/gsd-tools.cjs\":*)",
      "Bash(_GSD_SHIM_NAME=\"gsd-tools.cjs\":*)",
      "Bash(node \"/home/gjohnson/.claude/gsd-core/bin/gsd-tools.cjs\":*)",
      "Bash(node /home/gjohnson/.claude/gsd-core/bin/gsd-tools.cjs:*)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  }
}
